# Local path to the shared FLIR dataset (illustrative — replace locally).
# Per Jorge's inventory findings, the canonical source matching the reported
# 1,657-frame set is Imagenes.zip + Etiquetas.zip, NOT the various
# Dataset_Balanceado* / flir_base_* archives (those are cross-check only).
DATA_ROOT=/path/to/local/flir-data

# Path to the baseline YOLOv11 checkpoint from "Eyes in the Sky"
# (yolov11_best100.pt on the shared OneDrive), used to re-evaluate the
# baseline on the same test split for a comparable recall figure.
BASELINE_YOLO_WEIGHTS=/path/to/yolov11_best100.pt

# Optional: path to Jorge's canonical manifest (flir_canonical_candidate_v1.parquet)
# once shared, to align frame IDs and split assignment.
LEAKAGE_MANIFEST=/path/to/flir_canonical_candidate_v1.parquet

# Path to an extracted LandCover.ai v1 root (contains images/ and masks/),
# used for transfer-learning pretraining — see docs/training.md.
# Download: https://landcover.ai.linuxpolska.com/download/landcover.ai.v1.zip
LANDCOVER_AI_ROOT=/path/to/landcover.ai.v1
